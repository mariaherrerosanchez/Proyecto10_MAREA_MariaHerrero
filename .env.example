# Application
APP_ENV=development
APP_NAME=MAREA
APP_LOG_LEVEL=INFO

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# Local persistence
DATABASE_URL=sqlite:///./marea.db
CHROMA_PERSIST_DIRECTORY=./chroma

# Radar RSS (closed identifiers, never arbitrary URLs)
RADAR_RSS_SOURCES=elpais-tecnologia,elpais-ciencia
RADAR_REQUEST_TIMEOUT_SECONDS=5
RADAR_MAX_FEED_BYTES=1000000

# Radar RSS (closed identifiers, never arbitrary URLs)
RADAR_RSS_SOURCES=elpais-tecnologia,elpais-ciencia
RADAR_REQUEST_TIMEOUT_SECONDS=5
RADAR_MAX_FEED_BYTES=1000000

# LLM providers (the API key stays private; configure each model after verifying
# its availability for your Groq account)
LLM_PROVIDER=groq
GROQ_API_KEY=
# Default model used when no different option is selected in Crear.
GROQ_MODEL=openai/gpt-oss-120b
# Optional selectable Groq model slots. Leave blank until verified for the account.
GROQ_MODEL_SECONDARY=
GROQ_MODEL_TERTIARY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Observability (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=MAREA
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Future content and image providers (optional; not consumed yet)
ARXIV_API_BASE_URL=https://export.arxiv.org/api/query
FINANCIAL_DATA_API_KEY=
FINANCIAL_DATA_BASE_URL=
IMAGE_PROVIDER=
IMAGE_PROVIDER_API_KEY=
