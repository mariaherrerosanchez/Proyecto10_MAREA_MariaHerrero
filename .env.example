# Application
APP_ENV=development
APP_NAME=MAREA
APP_LOG_LEVEL=INFO

# Backend
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
BACKEND_CORS_ORIGINS=http://localhost:5173

# Frontend
VITE_API_BASE_URL=http://localhost:8000

# Local persistence
DATABASE_URL=sqlite:///./marea.db
CHROMA_PERSIST_DIRECTORY=./chroma

# LLM providers
GROQ_API_KEY=
GROQ_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=

# Observability (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=MAREA
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# Future content and image providers (optional)
ARXIV_API_BASE_URL=https://export.arxiv.org/api/query
FINANCIAL_DATA_API_KEY=
FINANCIAL_DATA_BASE_URL=
IMAGE_PROVIDER=
IMAGE_PROVIDER_API_KEY=
